2026-10-18T18:18:37.942Z DEBUG 16264 --- [steerproof-backend] [         task-1] o.s.web.client.DefaultRestClient         : Writing [{meta=PaperMetaDto[title=null, authors=null, year=null, journal=BMJ Open, doi=10.1136/bmjopen-2022-071395], claims=[ApprovedClaimDto[claimId=C-0001-001, approvedCopy=null, scientificClaim=Rising levels of overweight and obesity among people with type 1 diabetes (T1D) contribute to insulin resistance, dyslipidaemia, retinopathy, cardiometabolic complications, and psychological morbidity., consumerDraft=For people with type 1 diabetes, being overweight or obese can lead to insulin resistance, high cholesterol, eye problems, heart issues, and mental health concerns., quote=Rising levels of overweight and obesity among people with type 1 diabetes (T1D) contribute to insulin resistance, dyslipidaemia, retinopathy, cardiometabolic complications and psychological morbidity., findingClass=BACKGROUND, numbers=[], limitations=[], population=People with type 1 diabetes who are overweight and obese], ApprovedClaimDto[claimId=C-0001-002, approvedCopy=null, scientificClaim=The Manchester Intermittent and Daily diet Type 1 Diabetes App Study (MIDDAS-Type 1) aims to assess the safety, acceptability, and feasibility of remotely delivered intermittent low-energy diet (ILED) and continuous low-energy diet (CLED) programmes for people with type 1 diabetes (T1D) and overweight and obesity., consumerDraft=This study aims to find out if remotely supported low-energy diet programs are safe and practical for people with type 1 diabetes who are overweight or obese., quote=The Manchester Intermittent and Daily diet Type 1 Diabetes App Study (MIDDAS-Type 1) aims to assess the safety, acceptability and feasibility of remotely delivered ILED and CLED programmes for people with T1D and overweight and obesity., findingClass=PRIMARY, numbers=[], limitations=[], population=People with type 1 diabetes and overweight and obesity], ApprovedClaimDto[claimId=C-0001-003, approvedCopy=null, scientificClaim=Twelve participants with type 1 diabetes (T1D) and body mass index (BMI) ≥27.5 kg/m2 (or ≥25 kg/m2 in high-risk ethnic minorities) recruited from England will be randomised to a remotely delivered continuous low-energy diet (CLED) (n=6) or intermittent low-energy diet (ILED) (n=6) for 12 weeks., consumerDraft=This study will randomly assign 12 participants with type 1 diabetes and overweight or obesity in England to one of two remote diet programs for 12 weeks., quote=Twelve participants with T1D and body mass index ≥27.5 kg/m 2 (≥25 kg/m 2 in high-risk ethnic minorities) recruited from an National Health Service (NHS) trust and research register in England will be randomised to a remotely delivered CLED (n=6) or ILED (n=6) for 12 weeks., findingClass=PRIMARY, numbers=[NumberRefDto[value=Twelve, unit=participants, context=total participants], NumberRefDto[value=≥27.5, unit=kg/m 2, context=body mass index], NumberRefDto[value=≥25, unit=kg/m 2, context=body mass index in high-risk ethnic minorities], NumberRefDto[value=n=6, unit=participants, context=CLED group size], NumberRefDto[value=n=6, unit=participants, context=ILED group size], NumberRefDto[value=12, unit=weeks, context=duration of intervention]], limitations=[], population=12 participants with type 1 diabetes, male or female, aged 18-70 years, with BMI ≥27.5 kg/m2 and <50 kg/m2 (or ≥25 kg/m2 and <50 kg/m2 in high-risk minority ethnic groups), recruited from an NHS trust and research register in England], ApprovedClaimDto[claimId=C-0001-004, approvedCopy=null, scientificClaim=The primary outcome of this study will assess safety, specifically the occurrence of severe hypoglycaemia, ketonaemia, ketoacidosis, and time above and below target blood glucose., consumerDraft=The main goal of this study is to check the safety of the diets, looking at severe low blood sugar, high ketone levels, and blood sugar control., quote=The primary outcome will assess safety (occurrence of severe hypoglycaemia, ketonaemia, ketoacidosis and time above and below target blood glucose)., findingClass=PRIMARY, numbers=[], limitations=[], population=People with type 1 diabetes and overweight and obesity], ApprovedClaimDto[claimId=C-0001-005, approvedCopy=null, scientificClaim=Secondary outcomes of this study include study uptake, retention, dietary adherence, acceptability, intervention delivery fidelity, and potential efficacy in relation to change in weight, insulin requirements, glycated haemoglobin, lipids, insulin resistance (estimated glucose disposal rate), and quality of life., consumerDraft=The study will also look at how many people join and stay, how well they follow the diet, and potential changes in weight, insulin needs, and overall health., quote=Secondary outcomes include study uptake, retention, dietary adherence, acceptability, intervention delivery fidelity and potential efficacy in relation to change in weight, insulin requirements, glycated haemoglobin, lipids, insulin resistance (estimated glucose disposal rate) and quality of life., findingClass=SECONDARY, numbers=[], limitations=[], population=People with type 1 diabetes and overweight and obesity], ApprovedClaimDto[claimId=C-0001-006, approvedCopy=null, scientificClaim=Limitations of this study include the small sample size, the diets not being isocaloric over the 12-week trial period, and the lack of a control group., consumerDraft=This study has limitations, including a small number of participants, diets that are not calorie-matched, and no comparison group., quote=Limitations include the small sample size, the diets are not isocaloric over the 12-week trial period and the lack of control group., findingClass=PRIMARY, numbers=[NumberRefDto[value=12, unit=week, context=trial period]], limitations=[], population=Not stated], ApprovedClaimDto[claimId=C-0001-007, approvedCopy=null, scientificClaim=Type 1 diabetes (T1D) combined with overweight and obesity contributes to insulin resistance, dyslipidaemia, non-alcoholic fatty liver disease, retinopathy, cardiometabolic complications, and psychological morbidity., consumerDraft=Having type 1 diabetes along with being overweight or obese can lead to insulin resistance, high cholesterol, fatty liver, eye problems, heart issues, and mental health concerns., quote=T1D and overweight and obesity contribute to insulin resistance, dyslipidaemia, non-alcoholic fatty liver disease, retinopathy, cardiometabolic complications and psychological morbidity., findingClass=BACKGROUND, numbers=[], limitations=[], population=People with type 1 diabetes who are overweight and obese], ApprovedClaimDto[claimId=C-0001-008, approvedCopy=null, scientificClaim=There is little research on weight management in type 1 diabetes (T1D), and challenges in T1D include fear of hypoglycaemia and the burden of increased glucose monitoring and insulin adjustment alongside the energy restriction and increased physical activity required for weight loss., consumerDraft=There's limited research on weight management for type 1 diabetes, with challenges like fear of low blood sugar and the effort of managing glucose and insulin., quote=In contrast, there is little research on weight management in T1D. Challenges in T1D include fear of hypoglycaemia and the burden of increased glucose monitoring and insulin adjustment alongside the energy restriction and increased physical activity required for weight loss., findingClass=BACKGROUND, numbers=[], limitations=[], population=People with type 1 diabetes], ApprovedClaimDto[claimId=C-0001-009, approvedCopy=null, scientificClaim=The safety, acceptability, feasibility, and efficacy of continuous low-energy diets (CLED) providing 800 kcal (3347 kJ)/day in type 1 diabetes (T1D) is not established. Patients with T1D may be at risk of diabetic ketoacidosis (DKA), a potentially life-threatening condition, as well as severe hypoglycaemia with a CLED., consumerDraft=The safety and effectiveness of continuous low-energy diets (800 kcal/day) for type 1 diabetes are not yet known, and these diets might pose risks like diabetic ketoacidosis or severe low blood sugar., quote=The safety, acceptability, feasibility and efficacy of CLED (800 kcal (3347 kJ)/day) in T1D is not established. Patients with T1D may be at risk of diabetic ketoacidosis (DKA), a potentially life-threatening condition as well as severe hypoglycaemia with a CLED. No studies have tested CLED compared with ILED in patients with overweight and obesity and T1D., findingClass=BACKGROUND, numbers=[NumberRefDto[value=800, unit=kcal, context=CLED energy intake per day], NumberRefDto[value=3347, unit=kJ, context=CLED energy intake per day]], limitations=[], population=Patients with type 1 diabetes], ApprovedClaimDto[claimId=C-0001-010, approvedCopy=null, scientificClaim=High-frequency remote follow-up has been shown to enhance adherence and to be equivalent to face-to-face care (when matched for frequency), or superior to low-frequency face-to-face care in weight management interventions., consumerDraft=Frequent remote check-ins can help people stick to weight management plans and may be as good as or better than less frequent in-person visits., quote=High-frequency remote follow-up has been shown to enhance adherence, and to be equivalent to face-to-face care (matched for frequency), 17 or superior to low-frequency face-to-face care in weight management interventions. 18 Remote follow-up also reduces participant burden to attend face-to-face appointments., findingClass=BACKGROUND, numbers=[], limitations=[], population=People in weight management interventions], ApprovedClaimDto[claimId=C-0001-011, approvedCopy=null, scientificClaim=Participants in this study must have a body mass index (BMI) ≥27.5 kg/m2 and <50 kg/m2, or ≥25 kg/m2 and <50 kg/m2 if they are from high-risk minority ethnic groups, specifically South Asian, black African, and African Caribbean., consumerDraft=To join the study, participants need a BMI between 27.5 and 50 kg/m2, or between 25 and 50 kg/m2 if they are from certain high-risk ethnic backgrounds., quote=BMI ≥27.5 kg/m 2 and <50 kg/m 2 or ≥25 kg/m 2 and <50 kg/m 2 in high-risk minority ethnic groups, that is, South Asian, black African and African Caribbean., findingClass=PRIMARY, numbers=[NumberRefDto[value=≥27.5, unit=kg/m 2, context=BMI inclusion criterion], NumberRefDto[value=<50, unit=kg/m 2, context=BMI inclusion criterion], NumberRefDto[value=≥25, unit=kg/m 2, context=BMI inclusion criterion for high-risk minority ethnic groups], NumberRefDto[value=<50, unit=kg/m 2, context=BMI inclusion criterion for high-risk minority ethnic groups]], limitations=[], population=Male or female, aged 18-70 years, diagnosed with T1D for 12 months or longer, from England, with specified BMI criteria], ApprovedClaimDto[claimId=C-0001-012, approvedCopy=null, scientificClaim=When a participant commences their allocated diet in this study, basal insulin will be reduced by 50% on low-energy days and by 10% on Mediterranean days., consumerDraft=In this study, when participants start their diet, their basal insulin will be lowered by 50% on low-energy days and by 10% on Mediterranean diet days., quote=When a participant commences their allocated diet, basal insulin will be reduced by 50% on low-energy days, and 10% on Mediterranean days. Participants' existing insulin to carbohydrate ratios and sensitivity factors will continue., findingClass=PRIMARY, numbers=[NumberRefDto[value=50, unit=%, context=basal insulin reduction on low-energy days], NumberRefDto[value=10, unit=%, context=basal insulin reduction on Mediterranean days]], limitations=[], population=Participants with type 1 diabetes and overweight and obesity in the study], ApprovedClaimDto[claimId=C-0001-013, approvedCopy=null, scientificClaim=An optional follow-up visit at 52 weeks will assess the long-term impact of low-energy diets (LEDs) on changes in weight, body composition, waist and hip circumference, blood pressure (BP), glycated haemoglobin (HbA1c), estimated glucose disposal rate (eGDR), blood lipids, and quality of life in people with type 1 diabetes (T1D) and obesity., consumerDraft=An optional follow-up at 52 weeks will check the long-term effects of low-energy diets on weight, body measurements, blood pressure, blood sugar, and overall well-being for people with type 1 diabetes and obesity., quote=At their week 12 visit, participants will be invited to attend and consent to a follow-up visit at MFT at 52 weeks. This will capture change in weight, body composition, waist and hip circumference, BP, HbA1c, eGDR, blood lipids and quality of life (WEL-SF, 29 GAD-7, 30 PHQ-9 31 and ADDQoL 35 ) to assess the long-term impact of LEDs on people with T1D and obesity., findingClass=EXPLORATORY, numbers=[NumberRefDto[value=12, unit=week, context=initial intervention period], NumberRefDto[value=52, unit=weeks, context=follow-up visit duration]], limitations=[], population=People with type 1 diabetes and obesity who complete the 12-week intervention], ApprovedClaimDto[claimId=C-0001-014, approvedCopy=null, scientificClaim=Progression to a future efficacy trial will be considered if this feasibility trial achieves successful recruitment of 12 patients., consumerDraft=If this study successfully recruits 12 patients, it will help decide if a larger study on the diet programs should be done., quote=Recruitment: successful recruitment of 12 patients to the study., findingClass=PRIMARY, numbers=[NumberRefDto[value=12, unit=patients, context=recruitment target]], limitations=[], population=Patients with type 1 diabetes and overweight and obesity]], theme=, language=en, paperId=P-0001}] as "application/json" with org.springframework.http.converter.json.MappingJackson2HttpMessageConverter
