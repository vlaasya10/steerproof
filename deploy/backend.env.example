DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/steerproof
DB_USER=steer
DB_PASSWORD=replace-with-database-password
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_EXTRACT=gemini-2.5-flash
GEMINI_MODEL_VERIFY=gemini-2.5-flash
GEMINI_MODEL_WRITE=gemini-2.5-flash
LLM_MAX_RPM=8
DEPLOYMENT_ACCESS_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app
DEMO_MODE=false
PROCESSING_MODE=api
STORAGE_EPHEMERAL=true
# Render Free uses these temporary paths; files and caches are lost on restart.
STORAGE_DIR=/tmp/steerproof/storage
LLM_CACHE_DIR=/tmp/steerproof/storage/cache/llm
HF_HOME=/tmp/steerproof/cache/huggingface
XDG_CACHE_HOME=/tmp/steerproof/cache
# Optional free stock footage provider
PIXABAY_API_KEY=
